{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfazuredataproject1"
		},
		"AzureDLproject1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDLproject1'"
		},
		"AzureSqlDbProject1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDbProject1'"
		},
		"AzureDLproject1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagedataproject1.dfs.core.windows.net/"
		},
		"AzureSqlDbProject1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dbserverproject1.database.windows.net"
		},
		"AzureSqlDbProject1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "databaseproject1"
		},
		"AzureSqlDbProject1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminsunil"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfazuredataproject1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDLproject1_accountKey": {
						"value": "[parameters('AzureDLproject1_accountKey')]"
					},
					"AzureSqlDbProject1_password": {
						"value": "[parameters('AzureSqlDbProject1_password')]"
					},
					"AzureDLproject1_properties_typeProperties_url": {
						"value": "[parameters('AzureDLproject1_properties_typeProperties_url')]"
					},
					"AzureSqlDbProject1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDbProject1_properties_typeProperties_server')]"
					},
					"AzureSqlDbProject1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDbProject1_properties_typeProperties_database')]"
					},
					"AzureSqlDbProject1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDbProject1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}